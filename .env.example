# Safe defaults: the app starts, but the restricted NVL source stays locked.
HOST=0.0.0.0
PORT=8080
LLM_MODE=mock
OPENROUTER_MODEL=deepseek/deepseek-v4.1-flash
MAX_REQUESTS_PER_HOUR=30
MAX_CONTEXT_CHUNKS=8
MAX_CONCURRENT_CHATS=4
MAX_TRACKED_CLIENTS=10000
MODEL_MAX_TOKENS=1400
TRUST_PROXY_LOOPBACK=true

# Set both only after written permission from the NVL rights holders exists.
SOURCE_USE_PERMISSION_GRANTED=false
PERMISSION_EVIDENCE_FILE=

# Production uses OPENROUTER_API_KEY_FILE, never a browser-visible key.
OPENROUTER_API_KEY_FILE=
PUBLIC_BASE_URL=
